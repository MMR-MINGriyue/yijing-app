<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_gua"/>
    <!-- Android 13+ 主题色图标: 按 alpha 取形, 系统单色渲染 -->
    <monochrome android:drawable="@drawable/ic_gua"/>
</adaptive-icon>
